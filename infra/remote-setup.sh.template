#!/bin/bash
# Template for the one-shot VM setup script. Filled in by deploy.yml (sed substitution of the
# __PLACEHOLDER__ tokens below) and run via Azure Run Command, which executes it on the VM over
# the control plane -- no SSH port is involved.
#
# App secrets (.env) are base64-embedded and written byte-for-byte; they are never passed through
# a shell here, because a password/secret containing $, `, or " would otherwise be parsed as shell
# syntax. Docker Compose's own env_file reader treats .env as plain KEY=VALUE text, not a shell
# script, so this is safe. PLANEWEB_IMAGE/PLANEWEB_HOST are not secrets (an image tag and an
# Azure-assigned DNS name) and are safe to export directly for Compose's own ${...} substitution.
set -euo pipefail
umask 077

mkdir -p /opt/planeweb
cd /opt/planeweb
echo '__COMPOSE_B64__' | base64 -d > docker-compose.yml
echo '__CADDY_B64__' | base64 -d > Caddyfile
echo '__ENV_B64__' | base64 -d > .env
chmod 600 .env

export PLANEWEB_IMAGE='__PLANEWEB_IMAGE__'
export PLANEWEB_HOST='__PLANEWEB_HOST__'

GHCR_USERNAME='__GHCR_USERNAME__'
GHCR_TOKEN_B64='__GHCR_TOKEN_B64__'
if [ -n "$GHCR_USERNAME" ]; then
  echo "$GHCR_TOKEN_B64" | base64 -d | docker login ghcr.io -u "$GHCR_USERNAME" --password-stdin
fi

docker compose pull
docker compose up -d --remove-orphans
docker image prune -f

echo PLANEWEB_DEPLOY_OK
