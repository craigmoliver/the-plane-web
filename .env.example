# Copy to .env (never commit .env). Values here override docker-compose.yml.

# First admin account, created at startup if it doesn't exist. Change the password after first sign-in.
PlaneWeb__Auth__AdminEmail=admin@example.com
PlaneWeb__Auth__AdminPassword=change-me-now-1

# Local email/password accounts (true/false).
PlaneWeb__Auth__LocalLogin=true

# Microsoft work-account sign-in (Entra ID). Leave blank to disable. See docs/entra.md.
PlaneWeb__Auth__Entra__TenantId=
PlaneWeb__Auth__Entra__ClientId=
PlaneWeb__Auth__Entra__ClientSecret=
# Entra object IDs (not emails) made admin on sign-in. Add more as __1, __2, ...
PlaneWeb__Auth__Entra__AdminObjectIds__0=

# Google sign-in. Leave blank to disable. See docs/google.md.
PlaneWeb__Auth__Google__ClientId=
PlaneWeb__Auth__Google__ClientSecret=
# Seeds the allowlist once on first run only; after that, manage it on /admin/google-allowlist.
PlaneWeb__Auth__Google__AdminEmails__0=craigmoliver@hotmail.com
PlaneWeb__Auth__Google__AdminEmails__1=craigmoliver@gmail.com
PlaneWeb__Auth__Google__AllowedEmails__0=gradypjohnson@gmail.com

# Set to true when running behind Caddy or another reverse proxy (docker-compose.https.yml sets it).
PlaneWeb__TrustForwardedHeaders=false
# Networks allowed to send forwarded headers (default: private ranges). Example: 172.18.0.0/16
PlaneWeb__TrustedProxyNetworks=

# Used only by docker-compose.postgres.yml.
POSTGRES_PASSWORD=change-me-db-password
# Used only by docker-compose.https.yml: public DNS name or LAN host/IP.
PLANEWEB_HOST=
