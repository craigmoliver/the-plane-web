@page "/settings"
@using PlaneWeb.Core
@using PlaneWeb.Infrastructure.Services
@using System.Text.Json
@inherits UserFeedComponent
@inject IJSRuntime JS
@inject ICityGeocoder CityGeocoder

<PageTitle>Settings · The Plane Web</PageTitle>

<div class="settings">
    <header class="settings-header">
        <h1>The Plane Web Settings</h1>
        <nav><UserMenu /><a href="/map" class="btn">Live Map</a><a href="/wall" class="btn primary">Open Wall ▶</a></nav>
    </header>

    @if (s is null)
    {
        <p>Loading…</p>
    }
    else
    {
        <div class="settings-grid">
            <section class="panel">
                <h2>Display mode</h2>
                <div class="segmented">
                    <button class="@(s.Mode == DisplayMode.Area ? "on" : "")" @onclick="() => SetMode(DisplayMode.Area)">Area tracking</button>
                    <button class="@(s.Mode == DisplayMode.Flights ? "on" : "")" @onclick="() => SetMode(DisplayMode.Flights)">Flight tracking</button>
                </div>

                <label>Wall title <input @bind="s.Title" maxlength="40" /></label>

                @if (s.Mode == DisplayMode.Area)
                {
                    <h2>Area</h2>
                    <div class="segmented">
                        <button class="@(s.Shape == AreaShape.Radius ? "on" : "")" @onclick="() => SetShape(AreaShape.Radius)">Radius</button>
                        <button class="@(s.Shape == AreaShape.Polygon ? "on" : "")" @onclick="() => SetShape(AreaShape.Polygon)">Drawn shape</button>
                    </div>
                    <p class="hint">
                        @if (s.Shape == AreaShape.Radius) { <text>Click the map to set your location.</text> }
                        else { <text>Use the polygon/rectangle tools at the top-left of the map to draw an area. Click the map to set your reference location (used for distance/bearing).</text> }
                    </p>
                    <div class="row">
                        <label>Latitude <input type="number" step="0.0001" @bind="s.CenterLat" @bind:after="UpdateMap" /></label>
                        <label>Longitude <input type="number" step="0.0001" @bind="s.CenterLon" @bind:after="UpdateMap" /></label>
                    </div>
                    @CitySearch
                    <button class="btn" @onclick="UseMyLocation">📍 Use my location</button>
                    @if (s.Shape == AreaShape.Radius)
                    {
                        <label>Radius: @s.RadiusNm.ToString("0") nm (@((s.RadiusNm * 1.852).ToString("0")) km)
                            <input type="range" min="1" max="100" step="1" @bind="s.RadiusNm" @bind:event="oninput" @bind:after="UpdateMap" />
                        </label>
                    }
                    else
                    {
                        <p class="hint">Polygon points: @s.Polygon.Count</p>
                    }

                    <h2>Filters</h2>
                    <div class="row">
                        <label>Min altitude (ft) <input type="number" step="500" @bind="s.MinAltitudeFt" /></label>
                        <label>Max altitude (ft) <input type="number" step="500" @bind="s.MaxAltitudeFt" /></label>
                    </div>
                    <label class="check"><input type="checkbox" @bind="s.IncludeHelicopters" /> Include helicopters</label>
                    <label class="check"><input type="checkbox" @bind="s.IncludeLight" /> Include light / private aircraft</label>
                    <label class="check"><input type="checkbox" @bind="s.IncludeGround" /> Include aircraft on the ground</label>
                    <label>Flights per page <input type="number" min="1" max="20" @bind="s.MaxAreaFlights" /></label>
                    <label class="check"><input type="checkbox" @bind="s.AutoPage" /> Page through all aircraft (off = show only the nearest page)</label>
                }
                else
                {
                    <h2>Tracked flights (up to @WallSettings.MaxTracked)</h2>
                    <p class="hint">Enter flight numbers (UA123) or callsigns (UAL123, N12345).</p>
                    <ul class="tracked">
                        @foreach (var f in s.TrackedFlights)
                        {
                            <li><span class="mono">@f</span> <button class="btn small" aria-label="@($"Remove flight {f}")" title="@($"Remove {f}")" @onclick="() => s.TrackedFlights.Remove(f)">✕</button></li>
                        }
                    </ul>
                    @if (s.TrackedFlights.Count < WallSettings.MaxTracked)
                    {
                        <form class="row" @onsubmit="AddFlight" @onsubmit:preventDefault>
                            <input placeholder="e.g. AS 1" @bind="newFlight" maxlength="10" />
                            <button class="btn" type="submit">Add</button>
                        </form>
                        @if (!string.IsNullOrWhiteSpace(newFlight))
                        {
                            <p class="hint">Will track as <span class="mono">@CallsignNormalizer.Normalize(newFlight)</span></p>
                        }
                    }
                    <label>Reference location (for distance)</label>
                    @CitySearch
                    <div class="row">
                        <label>Latitude <input type="number" step="0.0001" @bind="s.CenterLat" /></label>
                        <label>Longitude <input type="number" step="0.0001" @bind="s.CenterLon" /></label>
                    </div>
                }

                <h2>Display</h2>
                <div class="row">
                    <label>Rotate pages every (s) <input type="number" min="3" max="120" @bind="s.RotateSeconds" /></label>
                    <label>Units
                        <select @bind="s.Units">
                            <option value="@UnitSystem.Imperial">Imperial (ft, mph, mi)</option>
                            <option value="@UnitSystem.Metric">Metric (m, km/h, km)</option>
                        </select>
                    </label>
                </div>

                <h2>Live map</h2>
                <div class="row">
                    <label>Flight path length (min) <input type="number" min="1" max="@WallSettings.MaxTrailMinutes" @bind="s.TrailMinutes" /></label>
                    <label>Default map style
                        <select @bind="s.MapLayer">
                            <option value="streets">Streets</option>
                            <option value="dark">Dark</option>
                            <option value="satellite">Satellite</option>
                        </select>
                    </label>
                </div>
                <label class="check"><input type="checkbox" @bind="s.MapShowAll" /> Show all aircraft in the area (off = only those on the wall)</label>
                <label class="check"><input type="checkbox" @bind="s.TraceBackfill" /> Load earlier flight path when an aircraft first appears (adsb.lol)</label>
                <p class="hint">Each browser remembers the map style you last picked; this sets the starting style.</p>

                <div class="actions">
                    <button class="btn primary" @onclick="Save">Save</button>
                    @if (status is not null) { <span class="status">@status</span> }
                    @if (validationError is not null) { <span class="error" role="alert">@validationError</span> }
                </div>
            </section>

            <section class="panel map-panel">
                @if (s.Mode == DisplayMode.Area)
                {
                    <div @ref="mapEl" class="map"></div>
                    <p class="hint">@liveSummary</p>
                }
                else
                {
                    <h2>Live status</h2>
                    @foreach (var t in Snapshot.Tracked)
                    {
                        <div class="live-row">
                            <span class="mono">@t.Callsign</span>
                            @if (t.Live is { } v)
                            {
                                <span>@(v.Route is { } r ? $"{r.Origin.Code} → {r.Destination.Code}" : "route unknown") · @Fmt.Alt(v.Aircraft, s.Units)</span>
                            }
                            else { <span class="dim">not currently airborne / not found</span> }
                        </div>
                    }
                }
            </section>
        </div>
    }
</div>

@code {
    // Editable copy; the saved settings (base.Settings) drive the live data until Save.
    private WallSettings? s;
    private ElementReference mapEl;
    private DotNetObjectReference<Settings>? selfRef;
    private bool mapReady;
    private string? newFlight;
    private string? status;
    private string? validationError;
    private string liveSummary = "";
    private string cityQuery = "";
    private IReadOnlyList<CityResult>? cityMatches;
    private bool showingCityMatches;
    private int cityActive = -1;
    private CancellationTokenSource? citySearchCts;
    private bool pendingCityScroll;

    private RenderFragment CitySearch => @<label>
        Search city
        <div class="city-search">
            <input type="text" role="combobox" aria-autocomplete="list" aria-controls="city-listbox"
                   aria-expanded="@(CityListOpen ? "true" : "false")"
                   aria-activedescendant="@(CityListOpen && cityActive >= 0 ? $"city-opt-{cityActive}" : null)"
                   @bind="cityQuery" @bind:event="oninput" @bind:after="SearchCitiesAsync"
                   @onblur="CloseCityMatches" @onkeydown="OnCityKeyDown" autocomplete="off" />
            @if (CityListOpen)
            {
                <div class="city-dropdown" id="city-listbox" role="listbox">
                    @for (var i = 0; i < cityMatches!.Count; i++)
                    {
                        var match = cityMatches[i];
                        <div id="@($"city-opt-{i}")" role="option" aria-selected="@(i == cityActive ? "true" : "false")"
                             class="city-option @(i == cityActive ? "active" : "")"
                             @onmousedown:preventDefault @onclick="() => PickCity(match)">@match.Label</div>
                    }
                </div>
            }
        </div>
    </label>;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        s = await SettingsSvc.GetAsync(UserId);
        UpdateSummary(Snapshot);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (pendingCityScroll)
        {
            pendingCityScroll = false;
            await ScrollCityOptionIntoView();
        }
        
        if (s is { Mode: DisplayMode.Area } && !mapReady)
        {
            selfRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("planeWebMap.init", mapEl, selfRef, MapState());
            mapReady = true;
            await PushAircraft(Snapshot);
        }
    }

        private object MapState() => new
    {
        lat = s!.CenterLat, lon = s.CenterLon, radiusNm = s.RadiusNm, shape = (int)s.Shape,
        polygon = s.Polygon.Select(p => new[] { p.Lat, p.Lon }).ToArray(),
    };

    private async Task UpdateMap()
    {
        if (mapReady) await JS.InvokeVoidAsync("planeWebMap.update", MapState(), false);
    }

    private bool CityListOpen => showingCityMatches && cityMatches is { Count: > 0 };

    private async Task SearchCitiesAsync()
    {
        citySearchCts?.Cancel();
        citySearchCts?.Dispose();
        // Hide the previous query's matches immediately so they can't be picked while the new search runs.
        cityMatches = null;
        showingCityMatches = false;
        cityActive = -1;

        var query = cityQuery.Trim();
        if (query.Length < 2)
        {
            citySearchCts = null;
            return;
        }

        var cts = citySearchCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(300, cts.Token); // debounce: a newer keystroke cancels this
            var results = await CityGeocoder.SearchAsync(query, cts.Token);
            // Only publish if this is still the latest search (a completion can race cancellation).
            if (!ReferenceEquals(cts, citySearchCts) || cts.IsCancellationRequested) return;
            cityMatches = results;
            showingCityMatches = true;
        }
        catch (OperationCanceledException) { /* superseded by a newer query */ }
    }

    private void CloseCityMatches() => showingCityMatches = false;

    private async Task OnCityKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Escape":
                citySearchCts?.Cancel();
                showingCityMatches = false;
                cityQuery = "";
                break;
            case "ArrowDown" when cityMatches is { Count: > 0 }:
                showingCityMatches = true;
                cityActive = (cityActive + 1) % cityMatches.Count;
                pendingCityScroll = true;
                break;
            case "ArrowUp" when cityMatches is { Count: > 0 }:
                showingCityMatches = true;
                cityActive = cityActive <= 0 ? cityMatches.Count - 1 : cityActive - 1;
                pendingCityScroll = true;
                break;
            case "Enter" when CityListOpen:
                await PickCity(cityMatches![cityActive >= 0 ? cityActive : 0]);
                break;
        }
    }

    private async Task ScrollCityOptionIntoView()
    {
        if (cityActive < 0) return;
        try
        {
            await JS.InvokeVoidAsync("planeWebUI.scrollIntoView", $"city-opt-{cityActive}");
        }
        catch { /* JS interop error; the list is still visible */ }
    }

    private async Task PickCity(CityResult result)
    {
        citySearchCts?.Cancel();
        s!.CenterLat = Math.Round(result.Lat, 5);
        s.CenterLon = Math.Round(result.Lon, 5);
        cityQuery = "";
        cityMatches = null;
        showingCityMatches = false;
        cityActive = -1;
        await UpdateMap();
    }

    [JSInvokable]
    public async Task OnCenterPicked(double lat, double lon)
    {
        s!.CenterLat = lat; s.CenterLon = lon;
        await UpdateMap();
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnPolygonDrawn(string json)
    {
        s!.PolygonJson = json;
        // Keep the selected shape in sync with what the poller will actually use.
        s.Shape = s.Polygon.Count >= 3 ? AreaShape.Polygon : AreaShape.Radius;
        await UpdateMap();
        StateHasChanged();
    }

    private async Task SetMode(DisplayMode m)
    {
        if (s!.Mode == m) return;
        if (mapReady) { await JS.InvokeVoidAsync("planeWebMap.dispose"); mapReady = false; }
        s.Mode = m;
    }

    private async Task SetShape(AreaShape shape)
    {
        s!.Shape = shape;
        await UpdateMap();
    }

    private async Task UseMyLocation()
    {
        var loc = await JS.InvokeAsync<double[]?>("planeWebMap.locate");
        if (loc is { Length: 2 }) await OnCenterPicked(loc[0], loc[1]);
        else status = "Location unavailable (browsers require HTTPS or localhost).";
    }

    private void AddFlight()
    {
        var cs = CallsignNormalizer.Normalize(newFlight ?? "");
        if (cs.Length > 0 && !s!.TrackedFlights.Contains(cs) && s.TrackedFlights.Count < WallSettings.MaxTracked)
            s.TrackedFlights.Add(cs);
        newFlight = null;
    }

    private async Task Save()
    {
        if (s!.MinAltitudeFt > s.MaxAltitudeFt) (s.MinAltitudeFt, s.MaxAltitudeFt) = (s.MaxAltitudeFt, s.MinAltitudeFt);
        if (s.Validate() is { } error) { status = null; validationError = error; return; }
        validationError = null;
        await SettingsSvc.SaveAsync(UserId, s);
        s = await SettingsSvc.GetAsync(UserId);
        await UpdateMap();
        status = $"Saved at {DateTime.Now:T}";
    }

    protected override async Task OnSnapshotAsync()
    {
        UpdateSummary(Snapshot);
        if (mapReady) await PushAircraft(Snapshot);
    }

    private void UpdateSummary(WallSnapshot snap) =>
        liveSummary = snap.UpdatedAt == DateTimeOffset.MinValue ? "Waiting for live data…"
            : $"{snap.AreaFlights.Count} aircraft in saved area · source {snap.Source} · {snap.UpdatedAt.ToLocalTime():T}";

    private async Task PushAircraft(WallSnapshot snap)
    {
        var list = snap.AreaFlights.Where(f => f.Aircraft.Position.HasValue).Select(f => new
        {
            lat = f.Aircraft.Lat, lon = f.Aircraft.Lon, label = Fmt.Ident(f.Aircraft),
        });
        try { await JS.InvokeVoidAsync("planeWebMap.setAircraft", list); } catch (JSDisconnectedException) { }
    }

    public override async ValueTask DisposeAsync()
    {
        await base.DisposeAsync();
        citySearchCts?.Cancel();
        citySearchCts?.Dispose();
        try { if (mapReady) await JS.InvokeVoidAsync("planeWebMap.dispose"); } catch (JSDisconnectedException) { }
        selfRef?.Dispose();
    }
}
