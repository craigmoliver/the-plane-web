@page "/wall"
@using PlaneWeb.Core
@using PlaneWeb.Infrastructure.Providers
@using PlaneWeb.Infrastructure.Services
@inherits UserFeedComponent
@inject IJSRuntime JS
@inject AircraftInfoService AircraftInfo

<PageTitle>@(s?.Title ?? "The Plane Web")</PageTitle>

<div class="wall" @ondblclick="Fullscreen" title="Double-click for fullscreen">
    <div class="wall-header">
        <span class="led amber">@(s?.Title ?? "THE PLANE WEB")</span>
        <span class="led dim">@(snap.Mode == DisplayMode.Area ? "AREA" : "TRACKING")</span>
        <span class="led green">@DateTime.Now.ToString("HH:mm:ss")</span>
    </div>

    @if (s is null || snap.UpdatedAt == DateTimeOffset.MinValue)
    {
        <div class="wall-empty led amber blink">ACQUIRING SIGNAL…</div>
    }
    else if (snap.Mode == DisplayMode.Area)
    {
        var page = AreaPage();
        if (page.Count == 0)
        {
            <div class="wall-empty led dim">NO AIRCRAFT IN RANGE</div>
        }
        else
        {
            <div class="board">
                <div class="board-row board-head led dim">
                    <span>FLIGHT</span><span>ROUTE</span><span>TYPE</span><span>ALT</span><span>SPD</span><span>DIST</span>
                </div>
                @foreach (var f in page)
                {
                    <div class="board-row" @key="f.Aircraft.Hex">
                        <span class="ident-cell"><AirlineLogo Callsign="@f.Aircraft.Callsign" /><span class="led amber big">@Fmt.Ident(f.Aircraft)</span></span>
                        <span class="led green route-cell" title="@RouteTitle(f.Route)">@(f.Route is { } r ? $"{r.Origin.Code}›{r.Destination.Code}" : "---›---")</span>
                        <span class="led white small">@Fmt.Type(f.Aircraft)</span>
                        <span class="led cyan">@Fmt.Climb(f.Aircraft.VerticalRateFpm) @Fmt.Alt(f.Aircraft, s.Units)</span>
                        <span class="led cyan">@Fmt.Speed(f.Aircraft.GroundSpeedKt, s.Units)</span>
                        <span class="led white">@Fmt.Dist(f.DistanceNm, s.Units) @(f.BearingDeg is { } b ? Geo.CompassPoint(b) : "")</span>
                    </div>
                }
            </div>
            @if (PageCount > 1)
            {
                <div class="pager">@for (var i = 0; i < PageCount; i++) { <span class="@(i == pageIndex % PageCount ? "on" : "")"></span> }</div>
            }
        }
    }
    else
    {
        var t = TrackedCurrent();
        if (t is null)
        {
            <div class="wall-empty led dim">NO FLIGHTS CONFIGURED — VISIT /SETTINGS</div>
        }
        else
        {
            <div class="flight-card" @key="t.Callsign">
                <div class="fc-ident">
                    <span class="ident-cell"><AirlineLogo Callsign="@t.Callsign" Class="large" /><span class="led amber huge">@t.Callsign</span></span>
                    @if (t.Live is { } lv)
                    {
                        <span class="led white small">@Fmt.Type(lv.Aircraft) @(lv.Aircraft.Registration is { } reg ? $"· {reg}" : "")</span>
                    }
                </div>
                @if (t.Live is not { } v)
                {
                    <div class="led dim big">NOT CURRENTLY TRACKED IN THE AIR</div>
                }
                else
                {
                    <div class="fc-route">
                        <div class="fc-ap">
                            <span class="led green huge">@(v.Route?.Origin.Code ?? "???")</span>
                            <span class="led dim small">@(v.Route?.Origin.City ?? v.Route?.Origin.Name)</span>
                        </div>
                        <div class="fc-progress">
                            <div class="track"><div class="fill" style="width:@Pct(v.Progress)"></div><div class="plane" style="left:@Pct(v.Progress)">✈</div></div>
                        </div>
                        <div class="fc-ap right">
                            <span class="led green huge">@(v.Route?.Destination.Code ?? "???")</span>
                            <span class="led dim small">@(v.Route?.Destination.City ?? v.Route?.Destination.Name)</span>
                        </div>
                    </div>
                    @if (v.Route is { Stops.Count: > 2 } multi)
                    {
                        <div class="led dim small fc-stops">VIA @string.Join(" › ", multi.Stops.Select(a => a.Code))</div>
                    }
                    <div class="fc-stats">
                        <div><span class="led dim small">ALTITUDE</span><span class="led cyan">@Fmt.Climb(v.Aircraft.VerticalRateFpm) @Fmt.Alt(v.Aircraft, s.Units)</span></div>
                        <div><span class="led dim small">SPEED</span><span class="led cyan">@Fmt.Speed(v.Aircraft.GroundSpeedKt, s.Units)</span></div>
                        <div><span class="led dim small">HEADING</span><span class="led cyan">@Fmt.Heading(v.Aircraft.TrackDeg)</span></div>
                        <div><span class="led dim small">REMAINING</span><span class="led white">@Fmt.Dist(v.RemainingNm, s.Units)</span></div>
                        <div><span class="led dim small">ETA (EST)</span><span class="led amber">@Fmt.Eta(v.EstimatedArrival, DateTimeOffset.UtcNow)</span></div>
                    </div>
                    <div class="fc-details">
                        @foreach (var (label, value) in LiveDetails(v))
                        {
                            <div><span class="led dim small">@label</span><span class="led white small">@value</span></div>
                        }
                        @foreach (var (label, value) in IdentityDetails(v.Aircraft))
                        {
                            <div><span class="led dim small">@label</span><span class="led white small">@value</span></div>
                        }
                    </div>
                }
            </div>
            @if (snap.Tracked.Count > 1)
            {
                <div class="pager">@for (var i = 0; i < snap.Tracked.Count; i++) { <span class="@(i == pageIndex % snap.Tracked.Count ? "on" : "")"></span> }</div>
            }
        }
    }

    <div class="wall-footer led dim small">
        @if (snap.Error is not null) { <span class="led red">⚠ @snap.Error</span> }
        <span>DATA: @(snap.Source ?? "—") · UPDATED @(snap.UpdatedAt == DateTimeOffset.MinValue ? "—" : snap.UpdatedAt.ToLocalTime().ToString("HH:mm:ss"))</span>
        <span><a href="/map">MAP</a> · <a href="/settings">SETTINGS</a> · <UserMenu /></span>
    </div>
</div>

@code {
    private WallSettings? s => Settings;
    private WallSnapshot snap => Snapshot;
    private int pageIndex;
    private Timer? rotateTimer, clockTimer;
    // Airframe registry details (manufacturer, model, owner, country) per hex. Unsuccessful lookups are
    // retried once the service's miss lifetime has passed, so a transient upstream outage heals itself.
    private readonly Dictionary<string, InfoEntry> infos = new(StringComparer.OrdinalIgnoreCase);
    private sealed record InfoEntry(AircraftInfo? Info, DateTimeOffset LoadedAt);
    private readonly HashSet<string> infoLoading = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        if (IsDisposed) return; // closed while loading: don't start timers nobody will stop
        StartRotation();
        clockTimer = new Timer(_ => InvokeAsync(StateHasChanged), null, 1000, 1000);
        PrefetchInfo();
    }

    protected override Task OnSnapshotAsync()
    {
        PrefetchInfo();
        return Task.CompletedTask;
    }

    /// <summary>Look up registry details for the tracked flights, in the background (cached by the service).</summary>
    private void PrefetchInfo()
    {
        foreach (var live in snap.Tracked.Select(t => t.Live).OfType<FlightView>())
        {
            var hex = live.Aircraft.Hex;
            if (!NeedsInfo(hex) || !infoLoading.Add(hex)) continue;
            var reg = live.Aircraft.Registration;
            _ = LoadInfoAsync(hex, reg);
        }
    }

    /// <summary>True when there is no usable result yet: never looked up, or a miss older than the service's miss lifetime.</summary>
    private bool NeedsInfo(string hex)
    {
        if (!infos.TryGetValue(hex, out var known)) return true;
        if (known.Info is { RegistryFound: true }) return false;
        return DateTimeOffset.UtcNow - known.LoadedAt >= AircraftInfoService.MissTtl;
    }

    private async Task LoadInfoAsync(string hex, string? reg)
    {
        AircraftInfo? info = null;
        // Registry only: the wall shows no photo, so skip the Planespotters request.
        try { info = await AircraftInfo.GetRegistryAsync(hex, reg, CancellationToken.None); }
        catch (Exception) { /* upstream failures are non-fatal: the card just omits the extra fields */ }
        if (IsDisposed) return;
        await InvokeAsync(() =>
        {
            infos[hex] = new InfoEntry(info, DateTimeOffset.UtcNow);
            infoLoading.Remove(hex);
            StateHasChanged();
        });
    }

    private IEnumerable<(string Label, string Value)> LiveDetails(FlightView v)
    {
        var a = v.Aircraft;
        var units = s!.Units;
        yield return ("VERT RATE", a.VerticalRateFpm is { } vr ? $"{Fmt.Climb(vr)} {(units == UnitSystem.Metric ? $"{vr * 0.00508:0.0} m/s" : $"{vr:N0} fpm")}" : "---");
        yield return ("DISTANCE", v.DistanceNm is { } d ? $"{Fmt.Dist(d, units)}{(v.BearingDeg is { } b ? $" {Geo.CompassPoint(b)}" : "")}" : "---");
        yield return ("SQUAWK", a.Squawk ?? "---");
        yield return ("POSITION", a.Position is { } p ? $"{p.Lat:0.0000}, {p.Lon:0.0000}" : "---");
    }

    private IEnumerable<(string Label, string Value)> IdentityDetails(Aircraft a)
    {
        var d = infos.TryGetValue(a.Hex, out var known) ? known.Info : null;
        string? Pick(params string?[] xs) => xs.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x));
        var rows = new (string, string?)[]
        {
            ("ICAO HEX", a.Hex.ToUpperInvariant()),
            ("REGISTRATION", Pick(d?.Registration, a.Registration)),
            ("TYPE CODE", Pick(d?.IcaoType, a.TypeCode)),
            ("MANUFACTURER", d?.Manufacturer),
            ("MODEL", d?.Type),
            ("OWNER", Pick(d?.Owner, a.Operator)),
            ("COUNTRY", d?.OwnerCountry),
            ("OPERATOR CODE", d?.OperatorFlag),
            ("CATEGORY", Fmt.CategoryName(a.Category)),
        };
        foreach (var (label, value) in rows)
            if (!string.IsNullOrWhiteSpace(value)) yield return (label, value!);
    }

    private void StartRotation()
    {
        rotateTimer?.Dispose();
        var period = TimeSpan.FromSeconds(Math.Max(3, s?.RotateSeconds ?? 8));
        rotateTimer = new Timer(_ => InvokeAsync(() => { pageIndex++; StateHasChanged(); }), null, period, period);
    }

    private static string? RouteTitle(FlightRoute? r) =>
        r is null ? null : string.Join(" → ", r.Stops.Select(a => $"{a.Code} – {a.City ?? a.Name}"));

    private int PageCount => s is null || !s.AutoPage ? 1 : Math.Max(1, (int)Math.Ceiling(snap.AreaFlights.Count / (double)s.MaxAreaFlights));

    private IReadOnlyList<FlightView> AreaPage()
    {
        var size = s!.MaxAreaFlights;
        return snap.AreaFlights.Skip(pageIndex % PageCount * size).Take(size).ToList();
    }

    private TrackedFlightView? TrackedCurrent() =>
        snap.Tracked.Count == 0 ? null : snap.Tracked[pageIndex % snap.Tracked.Count];

    private static string Pct(double? p) =>
        $"{Math.Clamp((p ?? 0) * 100, 0, 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}%";

    protected override Task OnUserSettingsChangedAsync()
    {
        pageIndex = 0;
        StartRotation();
        return Task.CompletedTask;
    }

    private async Task Fullscreen() => await JS.InvokeVoidAsync("planeWebMap.requestFullscreen");

    public override ValueTask DisposeAsync()
    {
        rotateTimer?.Dispose();
        clockTimer?.Dispose();
        return base.DisposeAsync();
    }
}
