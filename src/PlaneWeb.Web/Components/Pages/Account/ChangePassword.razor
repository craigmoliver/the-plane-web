@page "/account/change-password"
@attribute [ExcludeFromInteractiveRouting]
@using Microsoft.AspNetCore.Identity
@using PlaneWeb.Infrastructure.Data
@inject UserManager<AppUser> Users
@inject SignInManager<AppUser> SignIn
@inject NavigationManager Nav

<PageTitle>Change password · The Plane Web</PageTitle>

<div class="account">
    <div class="account-card">
        <h1>Change password</h1>
        @if (user is { IsExternal: true })
        {
            <p>Your work account's password is managed by your organization.</p>
            <a class="btn" href="/">Home</a>
        }
        else
        {
            @if (user?.MustChangePassword == true) { <p class="dim">You're using a temporary password. Choose a new one to continue.</p> }
            @if (Message is not null) { <p class="error" role="alert">@Message</p> }
            <EditForm Model="Input" FormName="change-password" OnValidSubmit="ChangeAsync" method="post">
                <label>Current password <input name="Input.Current" type="password" autocomplete="current-password" required /></label>
                <label>New password <input name="Input.New" type="password" autocomplete="new-password" minlength="10" required /></label>
                <label>Confirm new password <input name="Input.Confirm" type="password" autocomplete="new-password" minlength="10" required /></label>
                <p class="hint">At least 10 characters, including a lowercase letter and a digit.</p>
                <button class="btn primary wide" type="submit">Change password</button>
            </EditForm>
        }
    </div>
</div>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private PasswordInput Input { get; set; } = new();
    private AppUser? user;
    private string? Message;

    protected override async Task OnInitializedAsync() => user = await Users.GetUserAsync(HttpContext.User);

    private async Task ChangeAsync()
    {
        if (user is null || user.IsExternal) return;
        if (Input.New != Input.Confirm) { Message = "The new passwords don't match."; return; }
        if (Input.New == Input.Current) { Message = "Choose a different password."; return; }
        var r = await Users.ChangePasswordAsync(user, Input.Current, Input.New);
        if (!r.Succeeded) { Message = string.Join(" ", r.Errors.Select(e => e.Description)); return; }
        user.MustChangePassword = false;
        await Users.UpdateAsync(user);
        await SignIn.RefreshSignInAsync(user); // reissue the cookie without the temporary-password flag
        Nav.NavigateTo("/", forceLoad: true);
    }

    private sealed class PasswordInput
    {
        public string Current { get; set; } = "";
        public string New { get; set; } = "";
        public string Confirm { get; set; } = "";
    }
}
